<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.1 0 0.175" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="red"/>
        </collision>

        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.04">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="laser_frame">
    <material>
        <ambient>1 0 0 1</ambient>
        <diffuse>1 0 0 1</diffuse>
    </material>
    </gazebo>


    <gazebo reference="laser_frame">
        <sensor name="ydlidar_x2" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <update_rate>6</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>

    <!-- Use <ignition_frame_id> in Fortress/Edifice; use <gz_frame_id> in Harmonic/Garden -->
        <ignition_frame_id>laser_frame</ignition_frame_id>
            <gz_frame_id>laser_frame</gz_frame_id>
            <lidar>
                <scan>
                <horizontal>
                    <samples>500</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
                </scan>
            <range>
                <min>0.12</min>
                <max>8.0</max>
                <resolution>0.01</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
            </lidar>
        </sensor>
    </gazebo>
</robot>